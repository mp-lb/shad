{
  "name": "@mp-lb/shad",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "dev": "pnpm registry:build && cd apps/docs && next dev",
    "build": "pnpm registry:build && cd apps/docs && next build",
    "preview": "cd apps/docs && next start",
    "registry:build": "shadcn build registry.json -o apps/docs/public/r",
    "playground:install": "pnpm registry:build && shadcn add apps/docs/public/r/message-input.json apps/docs/public/r/json-viewer.json apps/docs/public/r/array-editor.json apps/docs/public/r/modal.json apps/docs/public/r/ui-states.json apps/docs/public/r/mdkit-editor.json apps/docs/public/r/structured-log-viewer.json --cwd apps/playground --yes --overwrite",
    "playground:dev": "pnpm playground:install && pnpm --filter playground dev",
    "playground:build": "pnpm playground:install && pnpm --filter playground build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mp-lb/mdkit": "^0.2.5",
    "@tailwindcss/postcss": "^4.1.17",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fumadocs-core": "^16.6.16",
    "fumadocs-mdx": "^14.2.9",
    "fumadocs-ui": "npm:@fumadocs/base-ui@^16.6.16",
    "lucide-react": "^0.554.0",
    "next": "^16.2.1",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.17",
    "tw-animate-css": "^1.3.6"
  },
  "devDependencies": {
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "shadcn": "^4.6.0",
    "typescript": "^6.0.3"
  }
}
